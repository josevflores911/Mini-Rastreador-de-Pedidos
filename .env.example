# ---- API (Spring Boot) ----
VITE_API_BASE_URL=http://localhost:8080/

# ---- Autenticação (JWT) ----
# URL base da API de autenticação: POST /login, POST /register (responde com { token, username?, role? })
VITE_AUTH_API_URL=http://localhost:8080/auth
# Onde o JWT fica guardado no navegador: chave e storage ("local" = localStorage, "session" = sessionStorage)
VITE_AUTH_TOKEN_STORAGE_KEY=token
VITE_AUTH_TOKEN_STORAGE=local
# Rota da tela de login (redirecionamento ao faltar sessão / receber 401)
VITE_LOGIN_PATH=/login
# Perfis autorizados a atualizar status (separados por vírgula). Vazio = todos (o backend decide via 403).
VITE_STATUS_UPDATE_ROLES=

# ---- Google Maps (NÃO coloque a chave real aqui; use .env.local) ----
VITE_GOOGLE_MAPS_API_KEY=SUA_CHAVE_GOOGLE_MAPS_AQUI
# Opcional: Map ID do Google Cloud (necessário para marcadores avançados). Se vazio, usa DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=

# ---- Contrato ----
# Envia latitude/longitude (e restaurante) no POST /orders; desative as coordenadas se o DTO for estrito
VITE_SEND_COORDINATES=true

# ---- Desenvolvimento ----
# Dados fictícios em memória, SOMENTE em `npm run dev`. Mantenha false para usar o backend real.
VITE_USE_MOCKS=false
