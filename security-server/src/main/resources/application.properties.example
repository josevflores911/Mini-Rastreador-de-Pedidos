# ============================================================
# SERVER CONFIGURATION
# ============================================================
server.port=8080
server.address=0.0.0.0

# ============================================================
# DATASOURCE (SQLite ou PostgreSQL/MySQL para Produção)
# ============================================================
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:sqlite:chego.db}
spring.datasource.driver-class-name=org.sqlite.JDBC

# ============================================================
# JPA & HIBERNATE
# ============================================================
spring.jpa.database-platform=org.hibernate.community.dialect.SQLiteDialect
spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=false
spring.jpa.open-in-view=false

# ============================================================
# FLYWAY MIGRATION
# ============================================================
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=true

# ============================================================
# JWT SECURITY (Em produção, defina JWT_SECRET via variável de ambiente)
# ============================================================
jwt.secret=${JWT_SECRET:SuaChaveSecretaParaAssinaturaJWTMuitoSeguraComMaisDe256Bits!}
jwt.expiration=${JWT_EXPIRATION_MS:86400000}

# ============================================================
# CORS
# ============================================================
cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:5173,http://localhost:3000,http://localhost:4173,http://localhost:8080,http://127.0.0.1:5173}
